        "entry_id": {
          "name": "Battery",
          "description": "The config entry id of the target battery."
        },
        "data": {
          "name": "Hex data",
          "description": "The raw frame as hex, e.g. 7e000103008c000042990d (spaces allowed)."
        }
      }
    },
    "restart_bms": {
      "name": "Restart BMS",
      "description": "Soft-reboot the battery's BMS (the app's \"Reboot system\"). Clears latched protections such as cell overvoltage after a full charge. Battery-only loads lose power briefly.",
      "fields": {
        "entry_id": {
          "name": "Battery",
          "description": "The config entry id of the target battery."
        }
      }
