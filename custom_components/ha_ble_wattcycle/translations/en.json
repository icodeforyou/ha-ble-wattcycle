{
  "config": {
    "flow_title": "{name}",
    "step": {
      "confirm": {
        "title": "Set up WattCycle battery",
        "description": "Add {name} (detected protocol: {device_type})?\n\nClose the WattCycle phone app while using this integration — the battery usually accepts only one connection at a time.",
        "data": {
          "use_hilink_auth": "Send HiLink auth key on connect"
        },
        "data_description": {
          "use_hilink_auth": "Enable only if telemetry stays empty or notifications are refused (GATT status 5)."
        }
      },
      "user": {
        "title": "Set up WattCycle battery",
        "data": {
          "address": "Battery",
          "use_hilink_auth": "Send HiLink auth key on connect"
        },
        "data_description": {
          "use_hilink_auth": "Enable only if telemetry stays empty or notifications are refused (GATT status 5)."
        }
      }
    },
    "abort": {
      "no_devices_found": "No WattCycle-compatible batteries found. Make sure the battery is powered on, in range of a Bluetooth adapter or proxy, and the phone app is closed.",
      "already_configured": "This battery is already configured."
    }
  },
